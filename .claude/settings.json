{
  "model": "claude-sonnet-4-6",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(jupyter:*)",
      "Bash(pip install:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/ColabIA/scripts/validate_notebooks.sh",
            "timeout": 30,
            "statusMessage": "Validando notebooks .ipynb..."
          }
        ]
      }
    ]
  }
}
