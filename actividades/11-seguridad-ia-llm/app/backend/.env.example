# ============================================================
# CONFIGURACIÓN DEL BACKEND — copia este fichero a .env
#   cp .env.example .env
# ============================================================

# URL pública del servidor Ollama en Colab (la que imprime el notebook al
# ejecutar la celda de Ngrok). Formato: https://xxxx-xxxx.ngrok-free.app
OLLAMA_URL=https://TU-URL.ngrok-free.app

# Nombre del modelo descargado en Ollama (debe coincidir con el del notebook).
# Opciones: llama3.2:1b (rápido) | llama3.2:3b (mejor calidad)
MODEL_NAME=llama3.2:1b

# System prompt del asistente. Define el DOMINIO y el comportamiento.
# En main.py este prompt puede ser extraído por el atacante (data exfiltration).
# En secure.py está protegido por strip_sensitive() y /api/status lo recorta.
SYSTEM_PROMPT=Eres un asistente de soporte técnico para software empresarial. Responde únicamente preguntas relacionadas con el uso de software, errores, configuración e instalación. No respondas preguntas fuera de ese ámbito.

# Número máximo de tokens por respuesta. Menos = más rápido; más = más detalle.
MAX_TOKENS=500

# Temperatura del modelo (0.0 = determinista, 1.0 = creativo).
# Para soporte técnico se recomienda un valor bajo.
TEMPERATURE=0.4

# Puerto en el que escucha el backend (el proxy de Vite apunta aquí).
BACKEND_PORT=8000

# Temas permitidos del dominio, separados por coma. Los usa check_scope()
# en secure.py para detectar respuestas fuera de dominio (scope drift).
ALLOWED_TOPICS=software,instalación,configuración,error,sistema,versión,actualización
