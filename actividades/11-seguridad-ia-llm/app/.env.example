# ============================================================
# CONFIGURACIÓN GENERAL DE LA APP
# ============================================================
# La configuración real del backend vive en backend/.env
# (copia backend/.env.example a backend/.env).
#
# Este fichero documenta las dos variables imprescindibles que el
# estudiante debe rellenar tras ejecutar el notebook de Colab:

# URL pública de Ollama que imprime el notebook al ejecutar la celda de Ngrok.
OLLAMA_URL=https://TU-URL.ngrok-free.app

# Modelo descargado en Ollama (debe coincidir con el del notebook).
MODEL_NAME=llama3.2:1b
